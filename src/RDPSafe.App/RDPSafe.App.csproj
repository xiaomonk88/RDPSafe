<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RDPSafe</AssemblyName>
    <RootNamespace>RDPSafe.App</RootNamespace>
    <Description>RDP 防暴力破解工具</Description>
    <AssemblyTitle>RDPSafe - 远程桌面防暴力破解工具</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\rdpsafe.ico</ApplicationIcon>
    <!-- 自定义入口：同一个 exe 既是界面，也是 Windows 服务（带 service 参数启动） -->
    <StartupObject>RDPSafe.App.Program</StartupObject>
    <!-- DPI 感知由 WPF 通过清单声明，托盘仅借用 WinForms 的 NotifyIcon -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <!-- 单文件发布：dotnet publish -c Release（见 build.cmd） -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RDPSafe.Core\RDPSafe.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\rdpsafe.ico" />
    <Resource Include="Assets\rdpsafe.png" />
  </ItemGroup>
</Project>
