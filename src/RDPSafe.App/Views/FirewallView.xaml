<UserControl x:Class="RDPSafe.App.Views.FirewallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RDPSafe.App">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBox Width="260" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" ui:Ext.Icon="&#xE721;"
                         ui:Ext.Placeholder="筛选名称 / 端口 / 地址 / 程序" />
                <Border Style="{StaticResource SegmentHost}" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="全部" GroupName="ff"
                                     IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=All}" />
                        <RadioButton Style="{StaticResource Segment}" Content="允许" GroupName="ff"
                                     IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=Allow}" />
                        <RadioButton Style="{StaticResource Segment}" Content="阻止" GroupName="ff"
                                     IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=Block}" />
                    </StackPanel>
                </Border>
                <CheckBox Style="{StaticResource Switch}" Content="仅显示已启用" IsChecked="{Binding OnlyEnabled}" Margin="16,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SoftButton}" Content="编辑" ui:Ext.Icon="&#xE70F;" Command="{Binding EditCommand}" />
                <Button Style="{StaticResource SoftButton}" Content="启用/禁用" ui:Ext.Icon="&#xE7E8;" Command="{Binding ToggleCommand}" Margin="8,0,0,0" />
                <Button Style="{StaticResource DangerSoftButton}" Content="删除" ui:Ext.Icon="&#xE74D;" Command="{Binding DeleteCommand}" Margin="8,0,0,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="新建规则" ui:Ext.Icon="&#xE710;" Command="{Binding NewCommand}" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="4,10,0,0" />

        <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <DataGrid x:Name="Grid" ItemsSource="{Binding Items}" ui:GridSelection.Enabled="True"
                      ui:GridSelection.SelectedItems="{Binding SelectedRows, Mode=OneWayToSource}"
                      MouseDoubleClick="Grid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="状态" Width="70" SortMemberPath="Enabled">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="Track" Width="30" Height="16" CornerRadius="8" Background="{StaticResource Success}" HorizontalAlignment="Left"
                                        ToolTip="已启用">
                                    <Ellipse x:Name="Knob" Width="10" Height="10" Fill="White" HorizontalAlignment="Right" Margin="0,0,3,0" />
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                        <Setter TargetName="Track" Property="Background" Value="#CBD5E1" />
                                        <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Left" />
                                        <Setter TargetName="Knob" Property="Margin" Value="3,0,0,0" />
                                        <Setter TargetName="Track" Property="ToolTip" Value="已禁用" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="规则名称" Width="2*" MinWidth="200" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding Description}">
                                    <Border Style="{StaticResource Pill}" Background="{StaticResource PrimarySoft}" Margin="0,0,8,0" Padding="6,1"
                                            Visibility="{Binding IsManaged, Converter={StaticResource Visible}}">
                                        <TextBlock Text="RDPSafe" Style="{StaticResource PillText}" Foreground="{StaticResource Primary}" FontSize="10.5" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="操作" Width="80" SortMemberPath="Action">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="P" Style="{StaticResource Pill}" Background="{StaticResource SuccessSoft}">
                                    <TextBlock x:Name="T" Text="允许" Style="{StaticResource PillText}" Foreground="{StaticResource Success}" />
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Action}" Value="Block">
                                        <Setter TargetName="P" Property="Background" Value="{StaticResource DangerSoft}" />
                                        <Setter TargetName="T" Property="Foreground" Value="{StaticResource Danger}" />
                                        <Setter TargetName="T" Property="Text" Value="阻止" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="协议" Width="80" Binding="{Binding ProtocolText}" ElementStyle="{StaticResource CellMuted}" />
                    <DataGridTextColumn Header="本地端口" Width="110" Binding="{Binding LocalPortsText}" ElementStyle="{StaticResource CellMono}" />
                    <DataGridTemplateColumn Header="远程地址" Width="*" MinWidth="140" SortMemberPath="RemoteAddresses">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RemoteAddressesText}" Style="{StaticResource CellMono}" ToolTip="{Binding RemoteAddressesText}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="程序" Width="*" MinWidth="110" SortMemberPath="ApplicationName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ApplicationText}" Style="{StaticResource CellMuted}" ToolTip="{Binding ApplicationName}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="编辑" ui:Ext.Icon="&#xE70F;"
                                  Command="{Binding PlacementTarget.DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="启用 / 禁用" ui:Ext.Icon="&#xE7E8;"
                                  Command="{Binding PlacementTarget.DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="删除" ui:Ext.Icon="&#xE74D;"
                                  Command="{Binding PlacementTarget.DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
