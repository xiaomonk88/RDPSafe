<UserControl x:Class="RDPSafe.App.Views.BansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RDPSafe.App">
    <DockPanel>
        <!-- 工具栏 -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource SegmentHost}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="封禁中" GroupName="bf"
                                     IsChecked="{Binding ActiveOnly, Converter={StaticResource Equals}, ConverterParameter=True}" />
                        <RadioButton Style="{StaticResource Segment}" Content="全部记录" GroupName="bf"
                                     IsChecked="{Binding ActiveOnly, Converter={StaticResource Equals}, ConverterParameter=False}" />
                    </StackPanel>
                </Border>
                <TextBox Width="240" Margin="12,0,0,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ui:Ext.Icon="&#xE721;"
                         ui:Ext.Placeholder="搜索 IP / 归属地 / 备注">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding QueryCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SoftButton}" Content="解封所选" ui:Ext.Icon="&#xE785;" Command="{Binding UnbanSelectedCommand}" />
                <Button Style="{StaticResource PrimaryButton}" Content="手动封禁" ui:Ext.Icon="&#xE710;" Command="{Binding ToggleBanFormCommand}" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- 手动封禁表单 -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="20,16"
                Visibility="{Binding ShowBanForm, Converter={StaticResource Visible}}">
            <StackPanel>
                <TextBlock Text="手动封禁 IP 或网段" Style="{StaticResource CardTitle}" />
                <TextBlock Text="支持单个 IP（如 1.2.3.4）或 CIDR 网段（如 1.2.3.0/24，最大 /8）" Style="{StaticResource Caption}" Margin="0,4,0,14" />
                <WrapPanel>
                    <TextBox Width="220" Text="{Binding BanIp, UpdateSourceTrigger=PropertyChanged}" ui:Ext.Placeholder="IP 或网段" FontFamily="{StaticResource MonoFont}" Margin="0,0,12,8" />
                    <Border Style="{StaticResource SegmentHost}" Margin="0,0,12,8">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="1 小时" GroupName="bh" IsChecked="{Binding BanHours, Converter={StaticResource Equals}, ConverterParameter=1}" />
                            <RadioButton Style="{StaticResource Segment}" Content="1 天" GroupName="bh" IsChecked="{Binding BanHours, Converter={StaticResource Equals}, ConverterParameter=24}" />
                            <RadioButton Style="{StaticResource Segment}" Content="7 天" GroupName="bh" IsChecked="{Binding BanHours, Converter={StaticResource Equals}, ConverterParameter=168}" />
                            <RadioButton Style="{StaticResource Segment}" Content="30 天" GroupName="bh" IsChecked="{Binding BanHours, Converter={StaticResource Equals}, ConverterParameter=720}" />
                            <RadioButton Style="{StaticResource Segment}" Content="永久" GroupName="bh" IsChecked="{Binding BanHours, Converter={StaticResource Equals}, ConverterParameter=0}" />
                        </StackPanel>
                    </Border>
                    <TextBox Width="220" Text="{Binding BanNote, UpdateSourceTrigger=PropertyChanged}" ui:Ext.Placeholder="备注（可选）" Margin="0,0,12,8" />
                    <Button Style="{StaticResource DangerButton}" Content="封禁" ui:Ext.Icon="&#xE72E;" Command="{Binding SubmitBanCommand}" Margin="0,0,8,8" />
                    <Button Style="{StaticResource GhostButton}" Content="取消" Command="{Binding ToggleBanFormCommand}" Margin="0,0,0,8" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="4,10,0,0" />

        <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid>
                <DataGrid ItemsSource="{Binding Items}" ui:GridSelection.Enabled="True"
                          ui:GridSelection.SelectedItems="{Binding SelectedRows, Mode=OneWayToSource}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="IP 地址" Width="170" Binding="{Binding Ip}" ElementStyle="{StaticResource CellMono}" />
                        <DataGridTextColumn Header="归属地" Width="*" MinWidth="130" Binding="{Binding Country}" ElementStyle="{StaticResource CellMuted}" />
                        <DataGridTextColumn Header="封禁时间" Width="165" Binding="{Binding BanTime, Converter={StaticResource UnixTime}}" ElementStyle="{StaticResource CellMono}" SortMemberPath="BanTime" />
                        <DataGridTextColumn Header="到期" Width="150" Binding="{Binding Converter={StaticResource Expiry}}" ElementStyle="{StaticResource CellMuted}" />
                        <DataGridTemplateColumn Header="原因" Width="100" SortMemberPath="Reason">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="P" Style="{StaticResource Pill}" Background="{StaticResource PrimarySoft}">
                                        <TextBlock x:Name="T" Text="{Binding ReasonText}" Style="{StaticResource PillText}" Foreground="{StaticResource Primary}" />
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Reason}" Value="blacklist">
                                            <Setter TargetName="P" Property="Background" Value="#F1F5F9" />
                                            <Setter TargetName="T" Property="Foreground" Value="{StaticResource Text}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Reason}" Value="instant">
                                            <Setter TargetName="P" Property="Background" Value="{StaticResource DangerSoft}" />
                                            <Setter TargetName="T" Property="Foreground" Value="{StaticResource Danger}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Reason}" Value="manual">
                                            <Setter TargetName="P" Property="Background" Value="{StaticResource TealSoft}" />
                                            <Setter TargetName="T" Property="Foreground" Value="{StaticResource Teal}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="说明" Width="*" MinWidth="140" Binding="{Binding Note, TargetNullValue=—}" ElementStyle="{StaticResource CellMuted}" />
                        <DataGridTemplateColumn Header="状态" Width="96" SortMemberPath="Active">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding UnbanReason}">
                                        <Ellipse x:Name="D" Width="7" Height="7" Fill="{StaticResource Warning}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="T" Text="封禁中" Foreground="{StaticResource Warning}" Margin="7,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Active}" Value="False">
                                            <Setter TargetName="D" Property="Fill" Value="{StaticResource Muted}" />
                                            <Setter TargetName="T" Property="Foreground" Value="{StaticResource Muted}" />
                                            <Setter TargetName="T" Property="Text" Value="已解封" />
                                            <Setter TargetName="T" Property="FontWeight" Value="Normal" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="解封" ui:Ext.Icon="&#xE785;"
                                      Command="{Binding PlacementTarget.DataContext.UnbanOneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="解封并加入白名单" ui:Ext.Icon="&#xE73E;"
                                      Command="{Binding PlacementTarget.DataContext.WhitelistOneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="查看登录记录" ui:Ext.Icon="&#xE81C;"
                                      Command="{Binding PlacementTarget.DataContext.ViewLoginsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="复制 IP" ui:Ext.Icon="&#xE8C8;"
                                      Command="{Binding PlacementTarget.DataContext.CopyIpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Items.Count, Converter={StaticResource Hidden}}">
                    <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="36" Foreground="#CBD5E1" HorizontalAlignment="Center" />
                    <TextBlock Text="当前没有封禁中的 IP" Foreground="{StaticResource Text2}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
