<UserControl x:Class="RDPSafe.App.Views.LoginsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RDPSafe.App">
    <DockPanel>
        <!-- 工具栏 -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBox Width="260" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ui:Ext.Icon="&#xE721;"
                         ui:Ext.Placeholder="搜索 IP / 用户名 / 归属地，回车查询">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding QueryCommand}" />
                        <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Border Style="{StaticResource SegmentHost}" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="全部" GroupName="lf"
                                     IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=All}" />
                        <RadioButton Style="{StaticResource Segment}" Content="失败" GroupName="lf"
                                     IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=Failure}" />
                        <RadioButton Style="{StaticResource Segment}" Content="成功" GroupName="lf"
                                     IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=Success}" />
                    </StackPanel>
                </Border>
                <CheckBox Style="{StaticResource Switch}" Content="实时刷新" IsChecked="{Binding Live}" Margin="16,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding SelectionText}" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Style="{StaticResource SoftButton}" Content="加入白名单" ui:Ext.Icon="&#xE73E;" Command="{Binding WhitelistSelectedCommand}" />
                <Button Style="{StaticResource DangerButton}" Content="封禁所选 IP" ui:Ext.Icon="&#xE72E;" Command="{Binding BanSelectedCommand}" Margin="8,0,0,0" />
                <Button Style="{StaticResource GhostButton}" ui:Ext.Icon="&#xE74D;" Command="{Binding ClearAllCommand}" Margin="6,0,0,0" ToolTip="清空全部登录记录" />
            </StackPanel>
        </Grid>

        <!-- 底部统计 -->
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="4,10,0,0">
            <Run Text="显示" /><Run Text="{Binding Items.Count, Mode=OneWay, StringFormat={}{0:N0}}" Foreground="{StaticResource Text}" />
            <Run Text="条 · 数据库共" /><Run Text="{Binding TotalCount, Mode=OneWay, StringFormat={}{0:N0}}" Foreground="{StaticResource Text}" />
            <Run Text="条记录 · 右键可快速封禁或加入白名单" />
        </TextBlock>

        <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid>
                <DataGrid x:Name="Grid" ItemsSource="{Binding Items}" ui:GridSelection.Enabled="True"
                          ui:GridSelection.SelectedItems="{Binding SelectedRows, Mode=OneWayToSource}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Width="170" Binding="{Binding Time, Converter={StaticResource UnixTime}}" ElementStyle="{StaticResource CellMono}" SortMemberPath="Time" />
                        <DataGridTemplateColumn Header="结果" Width="90" SortMemberPath="Success">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="P" Style="{StaticResource Pill}" Background="{StaticResource DangerSoft}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="D" Width="6" Height="6" Fill="{StaticResource Danger}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="T" Text="失败" Style="{StaticResource PillText}" Foreground="{StaticResource Danger}" Margin="5,0,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Success}" Value="True">
                                            <Setter TargetName="P" Property="Background" Value="{StaticResource SuccessSoft}" />
                                            <Setter TargetName="D" Property="Fill" Value="{StaticResource Success}" />
                                            <Setter TargetName="T" Property="Foreground" Value="{StaticResource Success}" />
                                            <Setter TargetName="T" Property="Text" Value="成功" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="来源 IP" Width="170" Binding="{Binding Ip}" ElementStyle="{StaticResource CellMono}" />
                        <DataGridTextColumn Header="归属地" Width="*" MinWidth="140" Binding="{Binding Country}" ElementStyle="{StaticResource CellMuted}" />
                        <DataGridTextColumn Header="用户名" Width="*" MinWidth="120" Binding="{Binding Username, TargetNullValue=—}" ElementStyle="{StaticResource CellMono}" />
                        <DataGridTextColumn Header="事件" Width="100" Binding="{Binding Source}" ElementStyle="{StaticResource CellMuted}" />
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="只看此 IP" ui:Ext.Icon="&#xE71C;"
                                      Command="{Binding PlacementTarget.DataContext.OnlyThisIpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="复制 IP" ui:Ext.Icon="&#xE8C8;"
                                      Command="{Binding PlacementTarget.DataContext.CopyIpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="封禁此 IP" ui:Ext.Icon="&#xE72E;"
                                      Command="{Binding PlacementTarget.DataContext.BanOneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="加入白名单" ui:Ext.Icon="&#xE73E;"
                                      Command="{Binding PlacementTarget.DataContext.WhitelistOneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Items.Count, Converter={StaticResource Hidden}}">
                    <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="36" Foreground="#CBD5E1" HorizontalAlignment="Center" />
                    <TextBlock Text="暂无登录记录" Foreground="{StaticResource Text2}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
