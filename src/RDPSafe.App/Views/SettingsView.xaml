<UserControl x:Class="RDPSafe.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RDPSafe.App">
    <UserControl.Resources>
        <!-- 设置行：左侧标题+说明，右侧控件 -->
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <!-- 右侧留出输入框/开关的宽度，避免说明文字被遮挡 -->
        <Style x:Key="RowDesc" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,3,130,0" />
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource BorderBrush}" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- 未保存提示条 -->
        <Border DockPanel.Dock="Bottom" Background="#1E293B" CornerRadius="12" Padding="18,10" Margin="0,14,0,0"
                Visibility="{Binding Dirty, Converter={StaticResource Visible}}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="#FBBF24" />
                    <TextBlock Text="有未保存的策略修改" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Content="撤销" Foreground="#CBD5E1" Command="{Binding RevertCommand}" />
                    <Button Style="{StaticResource PrimaryButton}" Content="保存设置" ui:Ext.Icon="&#xE74E;" Command="{Binding SaveCommand}" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="-8,0,-8,0">
            <Grid Margin="8,0,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ═══════════ 左列 ═══════════ -->
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,18">
                                <TextBlock Text="检测策略" Style="{StaticResource CardTitle}" />
                                <Button Style="{StaticResource LinkButton}" Content="恢复默认" HorizontalAlignment="Right" Command="{Binding ResetDefaultsCommand}" />
                            </Grid>

                            <Grid Style="{StaticResource Row}">
                                <StackPanel>
                                    <TextBlock Text="最大失败次数" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="同一 IP 在时间窗口内失败达到该次数即封禁" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                                <TextBox Style="{StaticResource NumberBox}" HorizontalAlignment="Right" Text="{Binding MaxFailures, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel>
                                    <TextBlock Text="时间窗口（分钟）" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="统计失败次数的滑动时间范围" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                                <TextBox Style="{StaticResource NumberBox}" HorizontalAlignment="Right" Text="{Binding WindowMinutes, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <StackPanel Margin="0,0,0,18">
                                <Grid>
                                    <TextBlock Text="敏感用户名（一次即封）" Style="{StaticResource RowTitle}" />
                                    <Button Style="{StaticResource LinkButton}" Content="填入常见用户名" HorizontalAlignment="Right" Command="{Binding FillCommonUsersCommand}" />
                                </Grid>
                                <TextBlock Text="使用这些用户名登录失败时立即封禁，逗号分隔。请勿填入你自己使用的账户名。" Style="{StaticResource RowDesc}" />
                                <TextBox Margin="0,10,0,0" Height="Auto" MinHeight="34" Padding="10,7" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}"
                                         Text="{Binding InstantBanUsers, UpdateSourceTrigger=PropertyChanged}" ui:Ext.Placeholder="例如：admin, test, guest" />
                            </StackPanel>
                            <Border Style="{StaticResource Divider}" />
                            <Grid Style="{StaticResource Row}">
                                <StackPanel>
                                    <TextBlock Text="内网地址参与检测" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="关闭后来自 10.x / 172.16-31.x / 192.168.x 等内网的失败不会触发封禁" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding ProtectPrivateIps}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel>
                                    <TextBlock Text="登录成功自动加入白名单" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="远程桌面登录成功的来源 IP 自动加入白名单，并解除其封禁。若密码泄露，攻击者 IP 也会被加入，请使用强密码" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding AutoWhitelistOnSuccess}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="防止误封自己" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="不封禁当前存在活动远程桌面会话的 IP" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding SkipActiveSessions}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="封禁与解封" Style="{StaticResource CardTitle}" Margin="0,0,0,18" />
                            <Grid Style="{StaticResource Row}">
                                <StackPanel>
                                    <TextBlock Text="自动解封" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="关闭时自动封禁为永久封禁" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding AutoUnban}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}" IsEnabled="{Binding AutoUnban}">
                                <StackPanel>
                                    <TextBlock Text="封禁时长（小时）" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="到期后自动从防火墙移除" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                                <TextBox Style="{StaticResource NumberBox}" HorizontalAlignment="Right" Text="{Binding BanHours, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}" IsEnabled="{Binding AutoUnban}">
                                <StackPanel>
                                    <TextBlock Text="递增封禁" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="同一 IP 每次再被封禁，时长翻倍（最长 1 年）" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding ProgressiveBan}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="封禁时断开现有连接" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="立即中断该 IP 已建立的 TCP 连接（IPv4）" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding KillConnections}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════════ 右列 ═══════════ -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="防护服务" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="防护引擎以 Windows 服务运行，开机自动启动，关闭本界面不影响防护" Style="{StaticResource Caption}" Margin="0,4,0,16" />
                            <Border Background="{StaticResource SurfaceAlt}" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource RowTitle}">
                                            <Run Text="服务状态：" />
                                            <Run Text="{Binding State.ServiceStateText, Mode=OneWay}" FontWeight="SemiBold" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding State.StatusDetail}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- 未安装 -->
                            <WrapPanel>
                                <WrapPanel.Style>
                                    <Style TargetType="WrapPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State.ServiceState}" Value="NotInstalled">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </WrapPanel.Style>
                                <Button Style="{StaticResource PrimaryButton}" Content="安装并启动服务" ui:Ext.Icon="&#xE896;" Command="{Binding InstallServiceCommand}" Margin="0,0,12,8" />
                                <TextBlock Text="安装后可在此启动、停止、重启或卸载服务" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,0,8" />
                            </WrapPanel>
                            <!-- 已安装 -->
                            <WrapPanel>
                                <WrapPanel.Style>
                                    <Style TargetType="WrapPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State.ServiceState}" Value="NotInstalled">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </WrapPanel.Style>
                                <Button Style="{StaticResource PrimaryButton}" Content="启动" ui:Ext.Icon="&#xE768;" Command="{Binding StartServiceCommand}" Margin="0,0,8,8"
                                        Visibility="{Binding State.Online, Converter={StaticResource Hidden}}" />
                                <Button Style="{StaticResource SoftButton}" Content="重启" ui:Ext.Icon="&#xE72C;" Command="{Binding RestartServiceCommand}" Margin="0,0,8,8"
                                        Visibility="{Binding State.Online, Converter={StaticResource Visible}}" />
                                <Button Style="{StaticResource SoftButton}" Content="停止" ui:Ext.Icon="&#xE71A;" Command="{Binding StopServiceCommand}" Margin="0,0,8,8"
                                        Visibility="{Binding State.Online, Converter={StaticResource Visible}}" />
                                <Button Style="{StaticResource DangerSoftButton}" Content="卸载服务" ui:Ext.Icon="&#xE74D;" Command="{Binding UninstallServiceCommand}" Margin="0,0,8,8" />
                            </WrapPanel>
                            <Border Style="{StaticResource Divider}" Margin="0,8,0,18" />
                            <Grid Style="{StaticResource Row}" Margin="0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowTitle}">
                                        <Run Text="登录审核策略：" />
                                        <Run Text="{Binding AuditText, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock Text="必须开启“审核登录（成功/失败）”，系统才会记录登录事件。引擎启动时也会自动检查。" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                                <Button Style="{StaticResource SoftButton}" Content="立即开启" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding FixAuditCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="引擎参数" Style="{StaticResource CardTitle}" Margin="0,0,0,18" />
                            <Grid Style="{StaticResource Row}">
                                <StackPanel>
                                    <TextBlock Text="兜底轮询间隔（秒）" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="引擎通过事件订阅实时响应，此项仅为订阅异常时的兜底检查周期" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                                <TextBox Style="{StaticResource NumberBox}" HorizontalAlignment="Right" Text="{Binding PollSeconds, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="日志保留（小时）" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="超过此时长的登录记录与操作日志会被自动清理（封禁记录不受影响）" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                                <TextBox Style="{StaticResource NumberBox}" HorizontalAlignment="Right" Text="{Binding RetentionHours, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="界面与数据" Style="{StaticResource CardTitle}" Margin="0,0,0,18" />
                            <Grid Style="{StaticResource Row}">
                                <StackPanel>
                                    <TextBlock Text="登录后在托盘启动" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="以管理员权限在系统托盘运行，接收封禁通知" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding TrayAutoStart}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel>
                                    <TextBlock Text="关闭窗口时最小化到托盘" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="关闭后可从托盘图标重新打开" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding CloseToTray}" />
                            </Grid>
                            <WrapPanel>
                                <Button Style="{StaticResource SoftButton}" Content="打开数据目录" ui:Ext.Icon="&#xE8B7;" Command="{Binding OpenDataDirCommand}" Margin="0,0,8,8" />
                                <Button Style="{StaticResource DangerSoftButton}" Content="清空历史数据" ui:Ext.Icon="&#xE74D;" Command="{Binding ResetDataCommand}" Margin="0,0,8,8" />
                                <Button Style="{StaticResource DangerSoftButton}" Content="解封全部 IP" ui:Ext.Icon="&#xE785;" Command="{Binding RemoveAllBlockRulesCommand}" Margin="0,0,0,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Source="/Assets/rdpsafe.png" Width="44" Height="44" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Grid.Column="1" Margin="14,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="RDPSafe" Style="{StaticResource CardTitle}" FontSize="16" />
                                    <Border Style="{StaticResource Pill}" Background="{StaticResource PrimarySoft}" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource PillText}" Foreground="{StaticResource Primary}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Windows 远程桌面防暴力破解工具" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                <TextBlock Margin="0,6,0,0" FontSize="12">
                                    <Hyperlink Command="{Binding OpenRepoCommand}" Foreground="{StaticResource Primary}">
                                        <Run Text="{Binding RepoUrl, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding UpdateText, Converter={StaticResource Visible}}">
                                    <TextBlock Text="{Binding UpdateText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource LinkButton}" Content="前往下载" Margin="6,0,0,0" Command="{Binding OpenUpdateCommand}"
                                            Visibility="{Binding UpdateUrl, Converter={StaticResource Visible}}" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource SoftButton}" Content="检查更新" ui:Ext.Icon="&#xE895;"
                                    Command="{Binding CheckUpdateCommand}" VerticalAlignment="Top" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" BorderBrush="#FECDD3">
                        <Grid>
                            <StackPanel Margin="0,0,140,0">
                                <TextBlock Text="完全卸载" Style="{StaticResource CardTitle}" Foreground="{StaticResource Danger}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                           Text="删除防护服务、全部 RDPSafe 防火墙规则、开机任务与所有数据，完成后退出。程序文件需手动删除。" />
                            </StackPanel>
                            <Button Style="{StaticResource DangerButton}" Content="完全卸载" ui:Ext.Icon="&#xE74D;" Command="{Binding FullUninstallCommand}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
