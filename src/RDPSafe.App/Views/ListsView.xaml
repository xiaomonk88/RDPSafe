<UserControl x:Class="RDPSafe.App.Views.ListsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RDPSafe.App">
    <UserControl.Resources>
        <DataTemplate x:Key="ListCard">
            <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                <DockPanel>
                    <!-- 标题 -->
                    <Grid DockPanel.Dock="Top" Margin="20,18,20,0">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="IcBg" Width="34" Height="34" CornerRadius="9" Background="{StaticResource SuccessSoft}">
                                <TextBlock x:Name="Ic" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="15" Foreground="{StaticResource Success}" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardTitle}">
                                    <Run Text="{Binding Title, Mode=OneWay}" />
                                    <Run Text="{Binding Items.Count, Mode=OneWay, StringFormat=· {0}}" Foreground="{StaticResource Muted}" FontWeight="Normal" />
                                </TextBlock>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- 添加 -->
                    <Grid DockPanel.Dock="Top" Margin="20,16,20,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewIp, UpdateSourceTrigger=PropertyChanged}" ui:Ext.Placeholder="IP 或网段，如 1.2.3.4" FontFamily="{StaticResource MonoFont}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBox Grid.Column="2" Text="{Binding NewNote, UpdateSourceTrigger=PropertyChanged}" ui:Ext.Placeholder="备注">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button x:Name="AddBtn" Grid.Column="4" Style="{StaticResource PrimaryButton}" Content="添加" ui:Ext.Icon="&#xE710;" Command="{Binding AddCommand}" />
                    </Grid>

                    <!-- 底部 -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,8">
                        <Grid>
                            <TextBlock Text="右键条目可复制 IP" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="6,0,0,0" />
                            <Button x:Name="RemoveBtn" Style="{StaticResource DangerSoftButton}" Content="移出名单" ui:Ext.Icon="&#xE74D;"
                                    Command="{Binding RemoveSelectedCommand}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Grid>
                        <DataGrid ItemsSource="{Binding Items}" ui:GridSelection.Enabled="True"
                                  ui:GridSelection.SelectedItems="{Binding SelectedRows, Mode=OneWayToSource}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="IP / 网段" Width="160" Binding="{Binding Ip}" ElementStyle="{StaticResource CellMono}" />
                                <DataGridTextColumn Header="归属地" Width="*" Binding="{Binding Country}" ElementStyle="{StaticResource CellMuted}" />
                                <DataGridTextColumn Header="备注" Width="*" Binding="{Binding Note, TargetNullValue=—}" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="添加时间" Width="100" Binding="{Binding Created, Converter={StaticResource UnixTimeShort}}" ElementStyle="{StaticResource CellMuted}" SortMemberPath="Created" />
                            </DataGrid.Columns>
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="复制 IP" ui:Ext.Icon="&#xE8C8;"
                                              Command="{Binding PlacementTarget.DataContext.CopyIpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="移出名单" ui:Ext.Icon="&#xE74D;"
                                              Command="{Binding PlacementTarget.DataContext.RemoveSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>
                        <TextBlock Text="名单为空" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Items.Count, Converter={StaticResource Hidden}}" />
                    </Grid>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBlack}" Value="True">
                    <Setter TargetName="IcBg" Property="Background" Value="{StaticResource DangerSoft}" />
                    <Setter TargetName="Ic" Property="Foreground" Value="{StaticResource Danger}" />
                    <Setter TargetName="Ic" Property="Text" Value="&#xE711;" />
                    <Setter TargetName="AddBtn" Property="Style" Value="{StaticResource DangerButton}" />
                    <Setter TargetName="RemoveBtn" Property="Content" Value="移出并解封" />
                    <Setter TargetName="RemoveBtn" Property="Style" Value="{StaticResource SoftButton}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- 当前远程 IP 提示 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimarySoft}" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="10"
                Padding="16,10" Margin="0,0,0,14" Visibility="{Binding ShowMyIpHint, Converter={StaticResource Visible}}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{StaticResource Primary}" />
                    <TextBlock Margin="10,0,0,0" Foreground="{StaticResource Text}" VerticalAlignment="Center">
                        <Run Text="你当前的远程桌面来源 IP 是" />
                        <Run Text="{Binding MyIp, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" />
                        <Run Text="，尚未加入白名单。建议加入，以免输错密码时把自己封禁。" />
                    </TextBlock>
                </StackPanel>
                <Button Style="{StaticResource PrimaryButton}" Content="加入白名单" Height="30" HorizontalAlignment="Right" Command="{Binding AddMyIpCommand}" />
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ContentControl Content="{Binding White}" ContentTemplate="{StaticResource ListCard}" Focusable="False" />
            <ContentControl Grid.Column="2" Content="{Binding Black}" ContentTemplate="{StaticResource ListCard}" Focusable="False" />
        </Grid>
    </DockPanel>
</UserControl>
