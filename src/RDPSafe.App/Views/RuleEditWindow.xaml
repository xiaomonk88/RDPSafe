<Window x:Class="RDPSafe.App.Views.RuleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:RDPSafe.App"
        Title="{Binding WindowTitle}" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource Text}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Border Background="White" CornerRadius="14" Margin="20" Effect="{StaticResource PopupShadow}">
        <DockPanel>
            <!-- 标题 -->
            <Grid DockPanel.Dock="Top" Margin="24,20,14,0" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                <StackPanel>
                    <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource CardTitle}" FontSize="17" />
                    <TextBlock Text="规则方向：入站。端口、地址支持逗号分隔多项与范围（如 3389,5000-5010）" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Style="{StaticResource GhostButton}" ui:Ext.Icon="&#xE711;" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="32" Height="32" Padding="0" IsCancel="True" Click="Cancel_Click" />
            </Grid>

            <!-- 按钮 -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceAlt}" CornerRadius="0,0,14,14" Padding="24,14" Margin="0,8,0,0">
                <Grid>
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SoftButton}" Content="取消" MinWidth="84" Click="Cancel_Click" />
                        <Button Style="{StaticResource PrimaryButton}" Content="保存" MinWidth="84" Margin="10,0,0,0" IsDefault="True" Click="Save_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 表单 -->
            <Grid Margin="24,20,24,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Label}">
                        <Setter Property="Foreground" Value="{StaticResource Text2}" />
                    </Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="Margin" Value="0,0,0,12" />
                    </Style>
                </Grid.Resources>

                <TextBlock Text="名称" Margin="0,0,0,12" />
                <TextBox Grid.Column="1" x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ui:Ext.Placeholder="规则名称" />

                <TextBlock Grid.Row="1" Text="描述" Margin="0,0,0,12" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" ui:Ext.Placeholder="可选" />

                <TextBlock Grid.Row="2" Text="操作" Margin="0,0,0,12" />
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource SegmentHost}" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="允许连接" GroupName="ra"
                                     IsChecked="{Binding Allow, Converter={StaticResource Equals}, ConverterParameter=True}" />
                        <RadioButton Style="{StaticResource Segment}" Content="阻止连接" GroupName="ra"
                                     IsChecked="{Binding Allow, Converter={StaticResource Equals}, ConverterParameter=False}" />
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="3" Text="协议" Margin="0,0,0,12" />
                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource SegmentHost}" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="TCP" GroupName="rp"
                                     IsChecked="{Binding Protocol, Converter={StaticResource Equals}, ConverterParameter=Tcp}" />
                        <RadioButton Style="{StaticResource Segment}" Content="UDP" GroupName="rp"
                                     IsChecked="{Binding Protocol, Converter={StaticResource Equals}, ConverterParameter=Udp}" />
                        <RadioButton Style="{StaticResource Segment}" Content="ICMPv4" GroupName="rp"
                                     IsChecked="{Binding Protocol, Converter={StaticResource Equals}, ConverterParameter=Icmp}" />
                        <RadioButton Style="{StaticResource Segment}" Content="任意" GroupName="rp"
                                     IsChecked="{Binding Protocol, Converter={StaticResource Equals}, ConverterParameter=Any}" />
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="4" Text="本地端口" Margin="0,0,0,12" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding LocalPorts, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding PortsEnabled}"
                         ui:Ext.Placeholder="留空表示任意，如 3389" FontFamily="{StaticResource MonoFont}" />

                <TextBlock Grid.Row="5" Text="远程端口" Margin="0,0,0,12" />
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding RemotePorts, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding PortsEnabled}"
                         ui:Ext.Placeholder="留空表示任意" FontFamily="{StaticResource MonoFont}" />

                <TextBlock Grid.Row="6" Text="远程地址" Margin="0,0,0,12" />
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding RemoteAddresses, UpdateSourceTrigger=PropertyChanged}"
                         ui:Ext.Placeholder="留空表示任意，如 1.2.3.4,10.0.0.0/8,LocalSubnet" FontFamily="{StaticResource MonoFont}" />

                <TextBlock Grid.Row="7" Text="程序" Margin="0,0,0,12" />
                <Grid Grid.Row="7" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Program, UpdateSourceTrigger=PropertyChanged}" ui:Ext.Placeholder="留空表示所有程序" />
                    <Button Grid.Column="1" Style="{StaticResource SoftButton}" Content="浏览" Margin="8,0,0,12" Click="Browse_Click" />
                </Grid>

                <TextBlock Grid.Row="8" Text="状态" />
                <CheckBox Grid.Row="8" Grid.Column="1" Style="{StaticResource Switch}" Content="启用此规则" IsChecked="{Binding Enabled}" />
            </Grid>
        </DockPanel>
    </Border>
</Window>
