<UserControl x:Class="RDPSafe.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RDPSafe.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="-8,0,-8,0">
        <StackPanel Margin="8,0,8,8">

            <!-- 防火墙关闭警告 -->
            <Border Background="{StaticResource DangerSoft}" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,16"
                    Visibility="{Binding State.FirewallOff, Converter={StaticResource Visible}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="20" Foreground="{StaticResource Danger}" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel Grid.Column="1" Margin="14,0,16,0">
                        <TextBlock FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource Danger}">
                            <Run Text="Windows 防火墙已关闭（" /><Run Text="{Binding State.FirewallOffProfiles, Mode=OneWay}" /><Run Text="），封禁不会生效" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Foreground="#9F1239"
                                   Text="RDPSafe 通过防火墙阻止规则拦截攻击来源。防火墙关闭时规则不起作用，被封禁的 IP 仍能继续尝试登录。" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource DangerButton}" Content="开启防火墙" ui:Ext.Icon="&#xEA18;"
                            Command="{Binding EnableFirewallCommand}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 防护状态 -->
            <Border Style="{StaticResource Card}" Padding="22,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource DangerSoft}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State.Protected}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SuccessSoft}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="&#xEA18;" FontSize="24" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State.Protected}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="17" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding State.StatusTitle}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State.Protected}" Value="True">
                                            <Setter Property="Text" Value="系统防护中" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" FontSize="12.5" Margin="0,4,0,0">
                            <Run Text="{Binding State.StatusDetail, Mode=OneWay}" />
                            <Run Text="  ·  当前策略：" />
                            <Run Text="{Binding State.PolicyText, Mode=OneWay}" Foreground="{StaticResource Text}" />
                        </TextBlock>
                        <Border Background="{StaticResource WarningSoft}" CornerRadius="8" Margin="0,8,0,0" Padding="10,4" HorizontalAlignment="Left">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State.Engine.AuditEnabled}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Foreground="{StaticResource Warning}" FontSize="12" Text="⚠ 登录审核策略未开启，系统不会记录登录失败事件，请在“设置”中修复" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButton}" Content="前往设置启动防护" ui:Ext.Icon="&#xE768;"
                                Command="{Binding GoToCommand}" CommandParameter="Settings"
                                Visibility="{Binding State.Online, Converter={StaticResource Hidden}}" />
                        <Button Style="{StaticResource SoftButton}" Content="查看封禁" ui:Ext.Icon="&#xE72E;"
                                Command="{Binding GoToCommand}" CommandParameter="Bans"
                                Visibility="{Binding State.Online, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 指标卡片 -->
            <UniformGrid Columns="4" Margin="-8,16,-8,0">
                <Border Style="{StaticResource Card}" Margin="8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource DangerSoft}">
                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" Foreground="{StaticResource Danger}" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Text="今日失败尝试" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding Stats.TodayFailures, StringFormat={}{0:N0}}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Danger}" Margin="0,14,0,2" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Last24Failures, StringFormat=近 24 小时 {0:N0} 次}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource WarningSoft}">
                                <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" Foreground="{StaticResource Warning}" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Text="活跃封禁" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding Stats.ActiveBans, StringFormat={}{0:N0}}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Warning}" Margin="0,14,0,2" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Stats.TodayNewBans, StringFormat=今日新增 {0:N0} 个}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource SuccessSoft}">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="{StaticResource Success}" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Text="今日成功登录" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding Stats.TodaySuccesses, StringFormat={}{0:N0}}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Success}" Margin="0,14,0,2" />
                        <TextBlock Style="{StaticResource Caption}" Text="仅统计远程桌面登录" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource PrimarySoft}">
                                <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" Foreground="{StaticResource Primary}" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Text="今日攻击来源" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding Stats.TodayAttackIps, StringFormat={}{0:N0}}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Primary}" Margin="0,14,0,2" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Stats.TotalBans, StringFormat=历史累计封禁 {0:N0} 次}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 趋势 + 攻击来源 -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="近 24 小时登录趋势" Style="{StaticResource CardTitle}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border Width="9" Height="9" CornerRadius="2" Background="#F43F5E" />
                                <TextBlock Text="失败" Style="{StaticResource Caption}" Margin="6,0,14,0" />
                                <Border Width="9" Height="9" CornerRadius="2" Background="#10B981" />
                                <TextBlock Text="成功" Style="{StaticResource Caption}" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="{Binding ChartMax, StringFormat=每小时峰值 {0:N0} 次}" />
                        <Grid Margin="0,18,0,0">
                            <!-- 参考线 -->
                            <StackPanel VerticalAlignment="Top" IsHitTestVisible="False">
                                <Border Height="1" Background="#EEF1F5" Margin="0,0,0,49" />
                                <Border Height="1" Background="#EEF1F5" Margin="0,0,0,49" />
                                <Border Height="1" Background="#EEF1F5" Margin="0,0,0,49" />
                                <Border Height="1" Background="#DDE2EA" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Bars}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Background="Transparent" ToolTip="{Binding Tip}">
                                            <Grid Height="150">
                                                <StackPanel VerticalAlignment="Bottom" Margin="2,0">
                                                    <Border Height="{Binding SuccessHeight}" Background="#10B981" CornerRadius="3,3,0,0" />
                                                    <Border Height="{Binding FailHeight}" Background="#F43F5E" CornerRadius="3,3,0,0" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding Label}" FontSize="10.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                                                       Margin="-20,8,-20,0" Visibility="{Binding ShowLabel, Converter={StaticResource Visible}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,20,12,14">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,8,10">
                            <TextBlock Text="攻击来源 Top 8" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="近 24 小时" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="暂无失败登录记录 🎉" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40"
                                       Visibility="{Binding TopAttackers.Count, Converter={StaticResource Hidden}}" />
                            <ItemsControl ItemsSource="{Binding TopAttackers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" CornerRadius="8" Padding="8,6" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Ip}" Style="{StaticResource Mono}" Foreground="{StaticResource Text}" />
                                                    <TextBlock Text="{Binding Country}" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0" FontWeight="SemiBold" Foreground="{StaticResource Danger}"
                                                           Text="{Binding Count, StringFormat={}{0:N0} 次}" />
                                                <Grid Grid.Column="2" Width="64" VerticalAlignment="Center">
                                                    <Border Style="{StaticResource Pill}" Background="{StaticResource WarningSoft}" HorizontalAlignment="Right"
                                                            Visibility="{Binding Banned, Converter={StaticResource Visible}}">
                                                        <TextBlock Text="已封禁" Style="{StaticResource PillText}" Foreground="{StaticResource Warning}" />
                                                    </Border>
                                                    <Button x:Name="BanBtn" Style="{StaticResource LinkButton}" Content="封禁" Foreground="{StaticResource Danger}"
                                                            HorizontalAlignment="Right" Visibility="Collapsed"
                                                            Command="{Binding DataContext.BanAttackerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                                <Grid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="查看登录记录" ui:Ext.Icon="&#xE81C;"
                                                                  Command="{Binding PlacementTarget.Tag.ViewLoginsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                        <MenuItem Header="封禁此 IP" ui:Ext.Icon="&#xE72E;"
                                                                  Command="{Binding PlacementTarget.Tag.BanAttackerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                        <MenuItem Header="加入白名单" ui:Ext.Icon="&#xE73E;"
                                                                  Command="{Binding PlacementTarget.Tag.WhitelistAttackerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                    </ContextMenu>
                                                </Grid.ContextMenu>
                                                <Grid.Tag>
                                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                </Grid.Tag>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceAlt}" />
                                            </Trigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Banned}" Value="False" />
                                                    <Condition Binding="{Binding IsMouseOver, ElementName=Row}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="BanBtn" Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 最近封禁 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,18,20,10">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="最近封禁" Style="{StaticResource CardTitle}" />
                        <Button Style="{StaticResource LinkButton}" Content="查看全部" HorizontalAlignment="Right"
                                Command="{Binding GoToCommand}" CommandParameter="Bans" />
                    </Grid>
                    <TextBlock Text="还没有封禁记录" Style="{StaticResource Caption}" Margin="0,16" HorizontalAlignment="Center"
                               Visibility="{Binding RecentBans.Count, Converter={StaticResource Hidden}}" />
                    <ItemsControl ItemsSource="{Binding RecentBans}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#EEF1F5" BorderThickness="0,1,0,0" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Ip}" Style="{StaticResource Mono}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Country}" Foreground="{StaticResource Text2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="2" Style="{StaticResource Pill}" Background="{StaticResource PrimarySoft}">
                                            <TextBlock Text="{Binding ReasonText}" Style="{StaticResource PillText}" Foreground="{StaticResource Primary}" />
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="{Binding Converter={StaticResource Expiry}}" Foreground="{StaticResource Text2}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding BanTime, Converter={StaticResource Relative}}" Foreground="{StaticResource Muted}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                                   ToolTip="{Binding BanTime, Converter={StaticResource UnixTime}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
