<Window x:Class="RDPSafe.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RDPSafe.App.ViewModels"
        xmlns:v="clr-namespace:RDPSafe.App.Views"
        xmlns:ui="clr-namespace:RDPSafe.App"
        Title="RDPSafe" Width="1240" Height="800" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="Manual"
        Background="{StaticResource Bg}" FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{StaticResource Text}" Icon="/Assets/rdpsafe.ico"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoginsViewModel}"><v:LoginsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BansViewModel}"><v:BansView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ListsViewModel}"><v:ListsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FirewallViewModel}"><v:FirewallView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}"><v:LogsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════ 侧栏 ═══════════ -->
        <Border Background="{StaticResource SidebarBg}">
            <DockPanel Margin="16,18,16,16">
                <!-- 品牌 -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,4,0,28">
                    <Image Source="/Assets/rdpsafe.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="RDPSafe" Foreground="White" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="远程桌面防暴力破解" Foreground="#7C8AA5" FontSize="11.5" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 状态卡片 -->
                <Border DockPanel.Dock="Bottom" CornerRadius="12" Padding="14,12" Background="#18223F" BorderBrush="#24304F" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="12" Height="12" VerticalAlignment="Center">
                                <Ellipse Width="12" Height="12">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#33F43F5E" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State.Protected}" Value="True">
                                                    <Setter Property="Fill" Value="#3310B981" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Ellipse Width="7" Height="7">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#F43F5E" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State.Protected}" Value="True">
                                                    <Setter Property="Fill" Value="#10B981" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>
                            <TextBlock Text="{Binding State.StatusTitle}" Foreground="White" FontWeight="SemiBold" Margin="9,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding State.StatusDetail}" Foreground="#8A97B1" FontSize="11.5" Margin="19,4,0,0" TextWrapping="Wrap" />
                        <Border Height="1" Background="#24304F" Margin="0,10" />
                        <Grid>
                            <TextBlock Foreground="#8A97B1" FontSize="11.5">
                                <Run Text="封禁中" />
                                <Run Text="{Binding ActiveBans, StringFormat={}{0:N0}, Mode=OneWay}" Foreground="White" FontWeight="SemiBold" />
                                <Run Text="个 IP" />
                            </TextBlock>
                            <TextBlock Text="{Binding Version}" Foreground="#56627E" FontSize="11" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- 导航 -->
                <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage}" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Ic" Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="16" Width="22" Foreground="#7C8AA5" />
                                <TextBlock x:Name="Tx" Text="{Binding Title}" FontSize="13.5" Margin="10,0,0,0" Foreground="#A9B4C8" VerticalAlignment="Center" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="Ic" Property="Foreground" Value="#A5B4FC" />
                                    <Setter TargetName="Tx" Property="Foreground" Value="White" />
                                    <Setter TargetName="Tx" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ═══════════ 主区域 ═══════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏按钮 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="最小化" />
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="最大化" />
                <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="关闭" />
            </StackPanel>

            <!-- 页面标题 -->
            <Grid Grid.Row="1" Margin="32,0,32,18">
                <StackPanel>
                    <TextBlock Text="{Binding CurrentPage.Title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding CurrentPage.Subtitle}" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="加载中…" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"
                               Visibility="{Binding CurrentPage.IsBusy, Converter={StaticResource Visible}}" />
                    <Button Style="{StaticResource SoftButton}" Content="刷新" ui:Ext.Icon="&#xE72C;" Command="{Binding RefreshPageCommand}" />
                </StackPanel>
            </Grid>

            <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" Margin="32,0,32,26" Focusable="False" />
        </Grid>

        <!-- ═══════════ 提示条 ═══════════ -->
        <Border Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="236,0,0,28"
                DataContext="{Binding Ui.Toast}" Visibility="{Binding Converter={StaticResource Visible}}"
                Background="#1E293B" CornerRadius="10" Padding="16,11" Effect="{StaticResource PopupShadow}" MaxWidth="560">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Glyph}" FontSize="15">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                            <Setter Property="Foreground" Value="#34D399" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="#FB7185" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Message}" Foreground="White" Margin="10,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="500" />
            </StackPanel>
        </Border>

        <!-- ═══════════ 对话框 ═══════════ -->
        <Grid Grid.ColumnSpan="2" DataContext="{Binding Ui.Dialog}" Visibility="{Binding Converter={StaticResource Visible}}" Background="#660B1224">
            <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" CornerRadius="14"
                    Padding="24,22" Effect="{StaticResource PopupShadow}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="18">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource PrimarySoft}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource DangerSoft}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Glyph}" HorizontalAlignment="Center" FontSize="16">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Foreground" Value="{StaticResource Primary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" FontSize="16" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource Text2}" LineHeight="21" Margin="48,10,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Content="{Binding CancelText}" Style="{StaticResource SoftButton}" Command="{Binding CancelCommand}" IsCancel="True"
                                MinWidth="84" Visibility="{Binding ShowCancel, Converter={StaticResource Visible}}" />
                        <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" MinWidth="84" Margin="10,0,0,0" IsDefault="True">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Danger}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
